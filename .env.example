# Aethera Healthcare Solutions — Environment Configuration

# Site URL
NEXT_PUBLIC_SITE_URL=https://aetherahealthcare.com

# ----------------------------------------------------------------------------
# LinkedIn Auto-Publisher Configuration
# Choose ONE of the two authentication methods below:
# ----------------------------------------------------------------------------

# Option A: Browser Session Cookie (Easiest & Fastest — zero developer app required)
# 1. Log into linkedin.com in Google Chrome
# 2. Open Chrome DevTools (F12) -> Application -> Cookies -> https://www.linkedin.com
# 3. Copy the string value of "li_at" and paste below:
LINKEDIN_LI_AT=

# Option B: Official LinkedIn REST API Token
# 1. Create an application on https://www.linkedin.com/developers
# 2. Add "Share on LinkedIn" product and generate an OAuth 2.0 User Token with "w_member_social" or "w_organization_social"
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:person:YOUR_NUMERIC_ID_HERE
