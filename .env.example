# ==============================================================================
# Aethera Healthcare Solutions — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env.local` for local development.
# For production deployments via GitHub Actions, add these as Repository
# Secrets or Variables in GitHub (Settings > Secrets and variables > Actions).
#
# Because Next.js uses static export (`output: 'export'`), all `NEXT_PUBLIC_*`
# variables are inlined at build time.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Analytics 4 (GA4)
# ------------------------------------------------------------------------------
# Found in: Google Analytics Admin > Data Streams > Web > Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-898JNZJ6LJ

# ------------------------------------------------------------------------------
# 2. Google Ads Conversion Tracking (gtag.js)
# ------------------------------------------------------------------------------
# Found in: Google Ads > Goals > Conversions > Summary > Google tag setup
# Defaults to the live account if unset.
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18295729018

# Google Ads Conversion Action Labels (alphanumeric string after the slash in send_to):
NEXT_PUBLIC_GADS_LABEL_ASSESSMENT=8gkvCJus38wcEPrWipRE
NEXT_PUBLIC_GADS_LABEL_CONTACT=
NEXT_PUBLIC_GADS_LABEL_MEETING=
NEXT_PUBLIC_GADS_LABEL_BOOKING=
NEXT_PUBLIC_GADS_LABEL_CALCULATOR=
NEXT_PUBLIC_GADS_LABEL_PILOT=

# ------------------------------------------------------------------------------
# 3. Cloudflare Web Analytics (Cookieless, Privacy-First)
# ------------------------------------------------------------------------------
# Found in: Cloudflare Dashboard > Analytics & Logs > Web Analytics
# Note: Cloudflare Pages can also inject this automatically via its dashboard toggle.
NEXT_PUBLIC_CF_BEACON_TOKEN=

# ------------------------------------------------------------------------------
# 4. B2B Retargeting Pixels (Pre-whitelisted in CSP)
# ------------------------------------------------------------------------------
# LinkedIn Insight Tag (Partner ID from LinkedIn Campaign Manager)
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# Meta (Facebook) Pixel ID (Dataset ID from Meta Events Manager)
NEXT_PUBLIC_META_PIXEL_ID=

# ------------------------------------------------------------------------------
# 5. B2B Visitor Deanonymization & Email Resolution (Pre-whitelisted in CSP)
# ------------------------------------------------------------------------------
# RB2B (Retention.com): Identifies US individuals' LinkedIn profiles & business emails
# Sign up at rb2b.com -> Copy your key from the script
NEXT_PUBLIC_RB2B_KEY=

# Apollo.io: Website Visitor Intelligence (Company + Contact identification)
NEXT_PUBLIC_APOLLO_ID=

# Leadfeeder / Dealfront: Company IP identification
NEXT_PUBLIC_LEADFEEDER_ID=

# Snitcher: Company IP identification
NEXT_PUBLIC_SNITCHER_ID=

# ------------------------------------------------------------------------------
# 6. CRM, API & Booking Links
# ------------------------------------------------------------------------------
# Aethera Cloudflare Worker CRM Ingest endpoint
NEXT_PUBLIC_CRM_API_URL=https://aethera-crm-api.aetherahealthcare.workers.dev/api/v1

# Primary Booking Calendar URL (Cal.com / Calendly)
NEXT_PUBLIC_BOOKING_URL=https://cal.com/kiran-kumar-pedapudi-qh822e/30min

# Canonical Site URL
NEXT_PUBLIC_SITE_URL=https://aetherahealthcare.com
