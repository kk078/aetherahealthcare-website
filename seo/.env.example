# SEO monitoring stack settings. Copy to seo/.env (gitignored) — `make seo-env` does it with random secrets.
# In GitHub Actions the same names are repository secrets/variables (see seo/README.md).

# --- Lighthouse CI server (infra/lhci-server)
# (Not LHCI_*: @lhci/cli reads every LHCI_* variable as a command-line option.)
SEO_LHCI_PORT=9001
SEO_LHCI_USER=aethera
SEO_LHCI_PASSWORD=change-me
# Set by `make seo-lhci-init`; leave the tokens blank to keep reports on disk only.
SEO_LHCI_SERVER_URL=http://127.0.0.1:9001
SEO_LHCI_TOKEN_MOBILE=
SEO_LHCI_TOKEN_DESKTOP=

# --- SEOnaut (infra/seonaut)
SEONAUT_PORT=9002
SEONAUT_DB_ROOT_PASSWORD=change-me
SEONAUT_DB_PASSWORD=change-me
# Local SEOnaut UI login, created by `make seo-crawl` on first run.
SEONAUT_EMAIL=seo-local@example.com
SEONAUT_PASSWORD=change-me

# --- SerpBear (infra/serpbear)
SERPBEAR_PORT=9003
SERPBEAR_USER=aethera
SERPBEAR_PASSWORD=change-me
SERPBEAR_SECRET=change-me
SERPBEAR_APIKEY=change-me
# Free Google Search Console access via a service account (read-only user on the property).
SEARCH_CONSOLE_CLIENT_EMAIL=
SEARCH_CONSOLE_PRIVATE_KEY=

# --- Scripts
# Delay between requests made by seo/scripts (ms). Keep >= 500 against production.
SEO_CRAWL_DELAY_MS=500
# Optional random token for the Cloudflare WAF skip rule (seo/README.md#cloudflare). Leave blank if unused.
SEO_BOT_TOKEN=
